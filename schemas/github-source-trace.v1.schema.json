{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mirrorcartographer.github.io/schemas/github-source-trace.v1.schema.json",
  "title": "Mirror Cartographer GitHub Source Trace",
  "description": "Public-safe link from a private source unit to a GitHub artifact and commit. Never contains raw source content.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "trace_id", "repository", "artifact_path", "commit_sha", "line_ranges", "source_ref", "source_digest", "source_kind", "relationship", "transformation", "claim_refs", "decision_refs", "privacy_scope", "raw_content_included", "completeness"],
  "properties": {
    "schema_version": { "const": "1.0.0" },
    "trace_id": { "type": "string", "pattern": "^MC-TRACE-[A-Z0-9-]{6,64}$" },
    "repository": { "type": "string", "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$" },
    "artifact_path": { "type": "string", "minLength": 1, "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$)).+$" },
    "commit_sha": { "type": "string", "pattern": "^[a-f0-9]{40}$" },
    "parent_sha": { "type": ["string", "null"], "pattern": "^[a-f0-9]{40}$" },
    "line_ranges": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["start", "end"],
        "properties": {
          "start": { "type": "integer", "minimum": 1 },
          "end": { "type": "integer", "minimum": 1 }
        }
      }
    },
    "source_ref": { "type": "string", "pattern": "^privsrc_[A-Za-z0-9_-]{12,96}$" },
    "source_digest": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
    "source_kind": { "enum": ["conversation_message", "conversation_span", "user_instruction", "file", "observation", "external_source"] },
    "relationship": { "enum": ["direct", "derived", "contextual"] },
    "transformation": { "type": "string", "minLength": 1, "maxLength": 240 },
    "claim_refs": { "type": "array", "items": { "type": "string", "pattern": "^[A-Z0-9][A-Z0-9._-]{2,80}$" }, "uniqueItems": true },
    "decision_refs": { "type": "array", "items": { "type": "string", "pattern": "^[A-Z0-9][A-Z0-9._-]{2,80}$" }, "uniqueItems": true },
    "privacy_scope": { "const": "private_source_public_metadata_only" },
    "raw_content_included": { "const": false },
    "completeness": { "enum": ["linked", "artifact_linked", "partial", "unavailable", "redacted", "disputed"] },
    "review_status": { "enum": ["unreviewed", "source_verified", "implementation_verified", "independently_reviewed"] },
    "notes_code": { "type": "string", "maxLength": 120, "pattern": "^[a-z0-9_-]*$" }
  }
}
