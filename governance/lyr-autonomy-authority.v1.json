{
  "schema": "mc.lyr-authority-grant.v1",
  "version": "1.1.0",
  "owner": "project-owner",
  "delegate": "lyr",
  "grant": {
    "capabilities": [
      "site.content.write",
      "site.feature.write",
      "network.component.write",
      "maintenance.repair",
      "workflow.modify",
      "release.deploy"
    ],
    "capability_scopes": {
      "site.content.write": {
        "prefixes": [
          "site/",
          "public/"
        ],
        "exact": []
      },
      "site.feature.write": {
        "prefixes": [
          "site/",
          "public/"
        ],
        "exact": []
      },
      "network.component.write": {
        "prefixes": [
          "network/"
        ],
        "exact": []
      },
      "maintenance.repair": {
        "prefixes": [
          "runtime/",
          "tools/"
        ],
        "exact": []
      },
      "workflow.modify": {
        "prefixes": [
          ".github/workflows/"
        ],
        "exact": []
      },
      "release.deploy": {
        "prefixes": [],
        "exact": [
          "owned-production"
        ]
      }
    },
    "blocked_data_classes": [
      "credentials",
      "secrets",
      "private_user_data",
      "health_data",
      "veterinary_data",
      "financial_data",
      "identity_data"
    ],
    "human_approval_required_for": [
      "irreversible",
      "destructive",
      "financial",
      "credential_access",
      "private_data_access",
      "unapproved_external_effect"
    ],
    "production_release": {
      "enabled": false,
      "target": "owned-production",
      "required_evidence": [
        "tests_passed",
        "rollback_available",
        "artifact_digest",
        "provenance_ref"
      ],
      "disabled_reason": "Awaiting independently verified CI and rollback attestation adapter."
    }
  }
}